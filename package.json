{
  "name": "@pi-contrib/pi-fusion",
  "version": "0.1.0",
  "description": "Single, Cascade, and Critique virtual-model workflows for Pi",
  "license": "MIT",
  "type": "module",
  "repository": "https://github.com/pi-contrib/pi-fusion.git",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "src/index.ts",
    "src/fusion.ts",
    "src/config.ts",
    "src/evidence.ts",
    "src/prompts.ts"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check src biome.json package.json tsconfig.json",
    "format": "biome check --write src biome.json package.json tsconfig.json",
    "test": "node --experimental-strip-types --test src/*.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@types/node": "^22",
    "typescript": "^7.0.2"
  }
}
